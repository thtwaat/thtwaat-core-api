# THTWAAT Production Environment Example
# Copy to .env.prod and fill secrets before: ./deploy.sh
# Validate with: ./deploy/validate-env.sh

APP_ENV=production
# Public launch: use certbot (or terminate TLS at the edge). simulate is for dry-runs only.
SSL_MODE=certbot
# SSL_MODE=simulate
SSL_ACME_EMAIL=ops@yourcompany.com
SSL_ACME_STAGING=true

DB_HOST=db
DB_PORT=5432
DB_NAME=thtwaat
DB_USER=thtwaat
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-jwt
JWT_REFRESH_SECRET_KEY=change-me-refresh

PUBLIC_API_BASE_URL=https://api.yourcompany.com
# Never use * in production
CORS_ORIGINS=["https://app.yourcompany.com"]

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=data/uploads

BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=3
SCHEDULER_INTERVAL_SECONDS=300

# Optional SMTP (EMAIL_PROVIDER=smtp required in production)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourcompany.com
SMTP_USE_TLS=true

# Observability links (monitoring compose)
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3000
# Prefer private-network scrape for /metrics, or set METRICS_TOKEN
# METRICS_TOKEN=

# Billing / AI (optional)
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# OPENAI_API_KEY=
