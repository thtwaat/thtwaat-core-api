# Frontend build args for docker compose -f docker-compose.prod.yml (web_app)
# Requires Docker Compose v2 (`docker compose`). Do not use legacy docker-compose 1.x.
# Copy values into .env / .env.prod used by compose — do not commit secrets.

NEXT_PUBLIC_API_URL=https://api.thtwaat.com
NEXT_PUBLIC_SITE_URL=https://app.thtwaat.com
NEXT_PUBLIC_SITE_NAME=THTWAAT
NEXT_PUBLIC_BRAND_COLOR=#0f766e
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Never put live agent API keys in NEXT_PUBLIC_* (browser bundle).

# Backend CORS must allow the app origin (ops .env — not a frontend file):
# CORS_ORIGINS=["https://app.thtwaat.com","https://admin.thtwaat.com","https://thtwaat.com"]
