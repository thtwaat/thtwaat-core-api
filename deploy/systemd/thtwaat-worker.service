[Unit]
Description=THTWAAT worker (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=thtwaat
Group=docker
WorkingDirectory=/opt/thtwaat/current
Environment=ENV_FILE=/opt/thtwaat/shared/.env.prod
EnvironmentFile=-/opt/thtwaat/shared/.env.prod
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --env-file /opt/thtwaat/shared/.env.prod up -d worker
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml --env-file /opt/thtwaat/shared/.env.prod stop worker
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
