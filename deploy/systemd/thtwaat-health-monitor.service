[Unit]
Description=THTWAAT health monitor check
After=network-online.target docker.service

[Service]
Type=oneshot
User=thtwaat
Group=docker
WorkingDirectory=/opt/thtwaat/current
Environment=ENV_FILE=/opt/thtwaat/shared/.env.prod
Environment=HEALTH_LOG=/opt/thtwaat/logs/health/health.log
ExecStart=/opt/thtwaat/current/deploy/scripts/health-monitor.sh
Nice=10
