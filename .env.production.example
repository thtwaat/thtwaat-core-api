APP_NAME="THTWAAT Core API"
APP_ENV=production

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=thtwaat_core
DB_USER=postgres
# ⚠️  SECURITY: Use a strong random password (32+ chars). Generate with:
#   openssl rand -base64 32
DB_PASSWORD=your_secure_db_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO / S3
MINIO_ROOT_USER=your_secure_minio_user_here
# ⚠️  SECURITY: Use a strong random password (16+ chars)
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
STORAGE_PROVIDER=local

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@yourcompany.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# ─── Security (REQUIRED — MUST change before production) ──────────────────────
# ⚠️  CRITICAL: These MUST be replaced with cryptographically secure random strings.
#   Generate JWT_SECRET_KEY:        openssl rand -hex 32
#   Generate JWT_REFRESH_SECRET_KEY: openssl rand -hex 32
#   Never use the same value for both keys.
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_64_CHAR_HEX_STRING

# ─── CORS (REQUIRED) ──────────────────────────────────────────────────────────
# ⚠️  SECURITY: Never use ["*"] in production. List only your actual frontend domains.
CORS_ORIGINS=["https://thtwaat.com", "https://app.thtwaat.com", "https://admin.thtwaat.com"]

# ─── AI Gateways (Optional — configure per provider) ────────────────────────
# ⚠️  SECURITY: Never commit real API keys to version control.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# AI Provider (gemini | openai | anthropic | openrouter | ollama)
AI_PROVIDER=gemini
OLLAMA_URL=http://localhost:11434

# ─── MFA ──────────────────────────────────────────────────────────────────────
MFA_ISSUER_NAME=THTWAAT Enterprise
