# Copy to .env.test (gitignored) or export before integration runs.
# Matches docker-compose.test.yml defaults.

DATABASE_URL=postgresql://thtwaat:thtwaat@localhost:5433/thtwaat_test
TEST_DATABASE_URL=postgresql://thtwaat:thtwaat@localhost:5433/thtwaat_test
REDIS_HOST=localhost
REDIS_PORT=6380
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380

JWT_SECRET_KEY=unit-test-jwt-secret-key-32chars!!
JWT_REFRESH_SECRET_KEY=unit-test-refresh-secret-key-32!
APP_ENV=test
STORAGE_PROVIDER=local
SSL_MODE=simulate

E2E_BASE_URL=http://localhost:8000
