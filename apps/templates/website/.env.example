# THTWAAT AI Website Starter — zero-config connection
# Copy to .env.local

# Public (browser)
NEXT_PUBLIC_API_URL=https://api.thtwaat.com
NEXT_PUBLIC_AGENT_API_KEY=tht_live_xxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SITE_NAME=THTWAAT Starter
NEXT_PUBLIC_BRAND_COLOR=#0F766E

# Optional widget
NEXT_PUBLIC_WIDGET_THEME=auto
NEXT_PUBLIC_WIDGET_POSITION=bottom-right

# Server-only (never expose)
# AGENT_API_KEY can override public key for server routes
AGENT_API_KEY=tht_live_xxxxxxxxx
API_URL=https://api.thtwaat.com

# Lead webhook (optional — falls back to console / local store)
LEADS_WEBHOOK_URL=
