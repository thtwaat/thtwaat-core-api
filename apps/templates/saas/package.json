{
  "name": "@thtwaat/saas-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready AI SaaS starter powered by THTWAAT Core API",
  "scripts": {
    "dev": "next dev --port 3300",
    "build": "next build",
    "start": "next start --port 3300",
    "typecheck": "tsc --noEmit",
