NEXT_PUBLIC_API_URL=https://api.thtwaat.com
NEXT_PUBLIC_SITE_URL=https://app.thtwaat.com
NEXT_PUBLIC_SITE_NAME=THTWAAT
NEXT_PUBLIC_BRAND_COLOR=#0f766e

# Optional billing checkout (client-side Razorpay publishable key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Do NOT put live agent API keys in NEXT_PUBLIC_* — they are embedded in the browser bundle.
# Create agent keys in the SaaS Settings UI after login.

# Optional lead/webhook forwarding for support forms
LEADS_WEBHOOK_URL=
